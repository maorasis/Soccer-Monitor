# Account wallet to FOLLOW (the Polymarket account/funder wallet, not necessarily the signer)
SOURCE_WALLET_ADDRESS=

# Existing CLOB API credentials for the signer whose orders you want to follow.
# These are NOT Relayer or Builder API keys. Do not put your source private key here.
SOURCE_SIGNER_ADDRESS=
SOURCE_API_KEY=
SOURCE_API_SECRET=
SOURCE_API_PASSPHRASE=

# Reem's existing funded Polymarket account and its signing key.
# Keep the real key in .env on the machine running the bot, never in chat or Git.
REEM_WALLET_ADDRESS=
REEM_PRIVATE_KEY=

POLL_SECONDS=2
POLYGON_RPC_URL=https://polygon.drpc.org

# Dedicated Telegram bot controls and notifications (required in live mode).
# Reem must open this bot's private chat. Only this numeric user ID is authorized.
REEM_TELEGRAM_BOT_TOKEN=
REEM_TELEGRAM_USER_ID=
